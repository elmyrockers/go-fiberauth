<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gray-100 flex items-center justify-center p-6">

    <div class="w-full max-w-md rounded-xl bg-white p-8 shadow-lg">

        <h1 class="mb-2 text-center text-3xl font-bold">
            Forgot Password
        </h1>

        <p class="mb-8 text-center text-sm text-gray-500">
            Enter your email address and we'll send you a password reset link.
        </p>

        <form method="POST" action="/auth/forgot-password" class="space-y-5">

            <div>
                <label for="email" class="mb-2 block text-sm font-medium">
                    Email
                </label>

                <input
                    id="email"
                    name="email"
                    type="email"
                    autocomplete="email"
                    autofocus
                    required
                    class="w-full rounded-lg border border-gray-300 px-3 py-2.5 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                >
            </div>

            <button
                type="submit"
                class="w-full rounded-lg bg-blue-600 px-4 py-3 font-medium text-white transition hover:bg-blue-700"
            >
                Send Reset Link
            </button>

        </form>

        <div class="mt-6 flex justify-between text-sm">

            <a
                href="/auth/login"
                class="font-medium text-blue-600 hover:underline"
            >
                Back to Sign In
            </a>

            <a
                href="/auth/register"
                class="font-medium text-blue-600 hover:underline"
            >
                Create Account
            </a>

        </div>

    </div>

</body>
</html>