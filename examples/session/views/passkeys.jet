<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Passkeys</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gray-100 flex items-center justify-center p-6">

<div class="w-full max-w-2xl rounded-xl bg-white p-8 shadow-lg">

    <div class="mb-8 flex items-center justify-between">

        <div>
            <h1 class="text-3xl font-bold">
                Passkeys
            </h1>

            <p class="mt-2 text-sm text-gray-500">
                Manage your registered passkeys.
            </p>
        </div>

        <button
            class="rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-blue-700">
            Add Passkey
        </button>

    </div>

    <div class="space-y-4">

        {{ range passkeys }}

        <div class="flex items-center justify-between rounded-lg border border-gray-200 p-5">

            <div>

                <h2 class="font-semibold">
                    {{ .Name }}
                </h2>

                <p class="mt-1 text-sm text-gray-500">
                    Created {{ .CreatedAt }}
                </p>

                <p class="text-xs text-gray-400">
                    Last used {{ .LastUsedAt }}
                </p>

            </div>

            <form method="POST" action="/auth/passkeys/delete">

                <input type="hidden" name="_csrf" value="{{ $.csrf }}">
                <input type="hidden" name="id" value="{{ .ID }}">

                <button
                    class="rounded-lg border border-red-300 px-4 py-2 text-sm text-red-600 hover:bg-red-50">
                    Delete
                </button>

            </form>

        </div>

        {{ end }}

    </div>

</div>

</body>
</html>