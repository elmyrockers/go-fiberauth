<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recovery Codes</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen bg-gray-100 flex items-center justify-center p-4">

<div class="w-full max-w-md rounded-xl bg-white p-6 shadow-lg">

    <!-- Copy success message -->
    <div
        id="copy-message"
        class="mb-4 hidden rounded-lg bg-green-50 px-4 py-3 text-center text-sm font-medium text-green-700">
        Recovery codes copied successfully!
    </div>


    <h1 class="text-center text-2xl font-bold">
        Recovery Codes
    </h1>


    <p class="mt-3 text-center text-sm text-gray-500">
        Recovery codes allow you to access your account if you lose access
        to your authenticator app. Each code can only be used once.
        Store these codes somewhere safe, such as a password manager.
    </p>


    <div
        id="recovery-codes"
        class="mt-5 grid grid-cols-2 gap-2 rounded-lg border bg-gray-50 p-4 font-mono text-sm">

        {{ range codes }}
        <div class="rounded-md border bg-white px-3 py-2 text-center">
            {{ . }}
        </div>
        {{ end }}

    </div>


    <button
        type="button"
        onclick="copyRecoveryCodes()"
        class="mt-5 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-sm font-medium transition hover:bg-gray-100">
        Copy Recovery Codes
    </button>


    <form method="POST" action="/auth/2fa/recovery-codes" class="mt-3">

        <input
            type="hidden"
            name="_csrf"
            value="{{ csrf }}">

        <button
            type="submit"
            class="w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-blue-700">
            Regenerate Recovery Codes
        </button>

    </form>


</div>


<script>
function copyRecoveryCodes() {

    const codes = [...document.querySelectorAll("#recovery-codes div")]
        .map(el => el.textContent.trim())
        .join("\n");


    navigator.clipboard.writeText(codes)
        .then(() => {

            const message = document.getElementById("copy-message");

            message.classList.remove("hidden");


            setTimeout(() => {
                message.classList.add("hidden");
            }, 2500);

        });

}
</script>


</body>
</html>