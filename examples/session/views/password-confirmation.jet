<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirm Password</title>

    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gray-100 flex items-center justify-center p-6">

    <div class="w-full max-w-md rounded-xl bg-white p-8 shadow-lg">

        <h1 class="mb-2 text-center text-3xl font-bold">
            Confirm Password
        </h1>

        <p class="mb-8 text-center text-sm text-gray-500">
            For your security, please confirm your password before continuing.
        </p>

        <form method="POST" action="/auth/password/confirm" class="space-y-5">
            <input type="hidden" name="_csrf" value="{{ csrf }}">
            <div>
                <label for="password" class="mb-2 block text-sm font-medium">
                    Password
                </label>

                <input
                    id="password"
                    name="password"
                    type="password"
                    autocomplete="current-password"
                    autofocus
                    required
                    class="w-full rounded-lg border border-gray-300 px-3 py-2.5 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
                >
            </div>

            <button
                type="submit"
                class="w-full rounded-lg bg-blue-600 px-4 py-3 font-medium text-white transition hover:bg-blue-700"
            >
                Confirm Password
            </button>

        </form>

    </div>

</body>
</html>